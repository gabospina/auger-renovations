<?php
session_start();

// --- Auth check: adapt to your pattern ---
$loggedIn = false;
foreach (['admin_logged_in', 'admin', 'logged_in', 'password_ok'] as $k) {
    if (!empty($_SESSION[$k]) && $_SESSION[$k] === true) { $loggedIn = true; break; }
}
if (!$loggedIn) { header('Location: admin.php'); exit; }

$configFile = __DIR__ . '/data/mail-config.json';
$settingsFile = __DIR__ . '/data/tenant-settings.json';

// Load existing
$config = file_exists($configFile) ? json_decode(file_get_contents($configFile), true) : [];
$settings = file_exists($settingsFile) ? json_decode(file_get_contents($settingsFile), true) : [];
$config = is_array($config) ? $config : [];
$settings = is_array($settings) ? $settings : [];

$message = '';

// Save handler
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $action = $_POST['action'] ?? '';

    if ($action === 'save_smtp') {
        $config['smtp_host'] = trim($_POST['smtp_host'] ?? '');
        $config['smtp_port'] = intval($_POST['smtp_port'] ?? 587);
        $config['smtp_user'] = trim($_POST['smtp_user'] ?? '');
        if (!empty($_POST['smtp_pass'])) {
            $config['smtp_pass'] = trim($_POST['smtp_pass']);
        }
        $config['from_name'] = trim($_POST['from_name'] ?? 'Auger Renovations');
        $config['admin_email'] = trim($_POST['admin_email'] ?? '');

        if (!is_dir(dirname($configFile))) mkdir(dirname($configFile), 0755, true);
        file_put_contents($configFile, json_encode($config, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
        $message = 'Configuration SMTP enregistrée.';
    }

    if ($action === 'save_review') {
        $settings['google_review_url'] = trim($_POST['google_review_url'] ?? '');
        file_put_contents($settingsFile, json_encode($settings, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
        $message = 'URL Google Review enregistrée.';
    }

    if ($action === 'test_email') {
        require_once __DIR__ . '/lib/mailer.php';
        if (!mail_configured()) {
            $message = '❌ SMTP non configuré.';
        } else {
            $result = send_mail(
                $config['admin_email'] ?? $config['smtp_user'],
                'Test — Auger Renovations',
                '<h2>Test email</h2><p>Si vous voyez ce message, votre configuration SMTP fonctionne.</p>'
            );
            $message = $result['success']
                ? '✅ Email de test envoyé avec succès.'
                : '❌ Échec: ' . htmlspecialchars($result['error']);
        }
    }
}
